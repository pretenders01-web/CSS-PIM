@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="cartao-vidro vazio">
    <h1 class="h3 fw-bold">Algo deu errado</h1>
    <p>Não foi possível concluir a sua solicitação. Tente novamente em instantes.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-secondary">Código do erro: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn-mt">Voltar ao início</a>
</div>
