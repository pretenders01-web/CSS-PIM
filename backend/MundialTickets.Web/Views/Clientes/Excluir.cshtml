@model MundialTickets.Modelos.Dtos.ClienteDto
@{
    ViewData["Title"] = "Excluir cliente";
}

<h1 class="h3 mb-3">Excluir cliente</h1>

<div class="alert alert-warning">Tem certeza de que deseja excluir este cliente? Esta ação não pode ser desfeita.</div>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nome)</dt>
    <dd class="col-sm-9">@Model.Nome</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Cpf)</dt>
    <dd class="col-sm-9">@Model.Cpf</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DataCadastro)</dt>
    <dd class="col-sm-9">@Model.DataCadastro.ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

<form asp-action="Excluir" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
