@model List<MundialTickets.Modelos.Dtos.ClienteDto>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 m-0">Clientes</h1>
    <a asp-action="Criar" class="btn btn-primary">Novo cliente</a>
</div>

@if (TempData["Mensagem"] is string mensagem)
{
    <div class="alert alert-success">@mensagem</div>
}

@* A busca chama a stored procedure sp_Clientes_BuscarPorNome *@
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-12 col-sm">
        <input name="busca" value="@ViewData["Busca"]" class="form-control" placeholder="Buscar por nome" aria-label="Buscar por nome" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpar</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <p class="text-muted">Nenhum cliente encontrado.</p>
}
else
{
    @* table-responsive: no celular a tabela rola de lado em vez de estourar a tela *@
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>CPF</th>
                    <th>Situação</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Nome</td>
                        <td>@c.Email</td>
                        <td>@c.Cpf</td>
                        <td>@(c.Ativo ? "Ativo" : "Inativo")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Editar" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Excluir" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
