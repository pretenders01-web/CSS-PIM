@model MundialTickets.Modelos.Dtos.ClienteSalvarDto
@{
    ViewData["Title"] = "Editar cliente";
}

<h1 class="h3 mb-3">Editar cliente</h1>

<div class="row">
    <div class="col-12 col-md-8 col-lg-6">
        @* O id vai na URL (/Clientes/Editar/5), não dentro do formulário *@
        <form asp-action="Editar" asp-route-id="@ViewData["Id"]" method="post">
            <partial name="_Formulario" model="Model" />
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a asp-action="Index" class="btn btn-link">Voltar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
